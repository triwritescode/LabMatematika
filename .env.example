# Copy to .env.local and fill with real values (see SETUP.md).
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time.
# The Supabase URL + anon key are client-safe by design (RLS protects data).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# OAuth 2.0 "Web application" client ID from Google Cloud Console.
# NOT the Android client ID — the native flow needs the Web client ID here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
