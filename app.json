{
  "expo": {
    "name": "Lab Matematika",
    "slug": "LabMatematika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/launchericon-512x512.png",
    "scheme": "labmatematika",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.labmatematika.app"
    },
    "android": {
      "package": "com.labmatematika.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/launchericon-512x512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Assets/favicon.svg"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/icons/launchericon-512x512.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
